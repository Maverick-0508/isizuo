{
  "compilerOptions": {
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "isolatedModules": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["functions/**/*.ts", "types.d.ts"]
}
